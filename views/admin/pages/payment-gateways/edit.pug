extends ../../layouts/default.pug
include ../../mixins/page-header.pug

block main
  +pageHeader("Chỉnh sửa cổng thanh toán", "Cập nhật thông tin cổng thanh toán")

  .admin-form-card
    form(
      action=`${prefixAdmin}/settings/payment-gateways/edit/${record.id}?_method=PATCH`
      method="POST"
    )
      .form-row
        .form-col
          .form-group
            label.form-label Tên Cổng
              span.required *
            input.form-input(
              type="text"
              name="name"
              required
              value=record.name
            )

          .form-group
            label.form-label API Key / App ID
            input.form-input(
              type="text"
              name="code"
              value=record.code
              required
            )
            
          .form-group
            label.form-label Endpoint
            input.form-input(
              type="text"
              name="endpoint"
              value=record.endpoint
            )

          .form-group
            label.form-label Trạng thái
            select.form-input.form-select(name="status")
              option(value="active" selected=(record.status === "active")) Đang bật
              option(value="inactive" selected=(record.status === "inactive")) Đã tắt

          .form-group.mb-0.mt-4
            button.btn.btn-add-product(type="submit")
              i.fas.fa-save.me-2
              | Cập nhật
            a.btn.btn-secondary.ms-2(href=`${prefixAdmin}/settings/payment-gateways`) Hủy

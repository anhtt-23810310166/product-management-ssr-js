extends ../../layouts/default.pug
include ../../mixins/page-header.pug

block main
  +pageHeader("Thêm mới hãng vận chuyển", "Thiết lập hãng vận chuyển mới")

  .admin-form-card
    form(
      action=`${prefixAdmin}/settings/shipping-carriers/create`
      method="POST"
    )
      .form-row
        .form-col
          .form-group
            label.form-label Tên hãng vận chuyển
              span.required *
            input.form-input(
              type="text"
              name="name"
              required
              placeholder="VD: Giao Hàng Tiết Kiệm"
            )

          .form-group
            label.form-label Phí giao hàng mặc định (₫)
            input.form-input(
              type="number"
              name="baseFee"
              value="30000"
              min="0"
            )

          .form-group
            label.form-label Trạng thái
            select.form-input.form-select(name="status")
              option(value="active" selected) Hoạt động
              option(value="inactive") Dừng hoạt động

          .form-group.mb-0.mt-4
            button.btn.btn-add-product(type="submit")
              i.fas.fa-plus.me-2
              | Thêm mới
            a.btn.btn-secondary.ms-2(href=`${prefixAdmin}/settings/shipping-carriers`) Hủy

extends ../../layouts/default.pug
include ../../mixins/page-header.pug

block main
  +pageHeader("Thêm mới cổng thanh toán", "Tích hợp cổng thanh toán mới")

  .admin-form-card
    form(
      action=`${prefixAdmin}/settings/payment-gateways/create`
      method="POST"
    )
      .form-row
        .form-col
          .form-group
            label.form-label Tên Cổng
              span.required *
            input.form-input(
              type="text"
              name="name"
              required
              placeholder="VD: VNPay"
            )

          .form-group
            label.form-label API Key / App ID
              span.required *
            input.form-input(
              type="text"
              name="code"
              required
              placeholder="VD: vnpay"
            )
            
          .form-group
            label.form-label Endpoint
            input.form-input(
              type="text"
              name="endpoint"
              placeholder="https://sandbox.vnpayment.vn/paymentv2/vpcpay.html"
            )

          .form-group
            label.form-label Trạng thái
            select.form-input.form-select(name="status")
              option(value="active" selected) Đang bật
              option(value="inactive") Đã tắt

          .form-group.mb-0.mt-4
            button.btn.btn-add-product(type="submit")
              i.fas.fa-plus.me-2
              | Thêm mới
            a.btn.btn-secondary.ms-2(href=`${prefixAdmin}/settings/payment-gateways`) Hủy

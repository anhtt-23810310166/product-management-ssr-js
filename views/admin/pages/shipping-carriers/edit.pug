extends ../../layouts/default.pug
include ../../mixins/page-header.pug

block main
  +pageHeader("Chỉnh sửa hãng vận chuyển", "Cập nhật thông tin hãng vận chuyển")

  .admin-form-card
    form(
      action=`${prefixAdmin}/settings/shipping-carriers/edit/${record.id}?_method=PATCH`
      method="POST"
    )
      .form-row
        .form-col
          .form-group
            label.form-label Tên hãng vận chuyển
              span.required *
            input.form-input(
              type="text"
              name="name"
              required
              value=record.name
            )

          .form-group
            label.form-label Phí giao hàng mặc định (₫)
            input.form-input(
              type="number"
              name="baseFee"
              value=record.baseFee
              min="0"
            )

          .form-group
            label.form-label Trạng thái
            select.form-input.form-select(name="status")
              option(value="active" selected=(record.status === "active")) Hoạt động
              option(value="inactive" selected=(record.status === "inactive")) Dừng hoạt động

          .form-group.mb-0.mt-4
            button.btn.btn-add-product(type="submit")
              i.fas.fa-save.me-2
              | Cập nhật
            a.btn.btn-secondary.ms-2(href=`${prefixAdmin}/settings/shipping-carriers`) Hủy

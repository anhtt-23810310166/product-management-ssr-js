extends ../../layouts/default.pug
include ../../mixins/page-header.pug
include ../../mixins/category-options.pug

block main
  +pageHeader("Thêm sản phẩm mới", "Điền thông tin để tạo sản phẩm")

  .admin-form-card
    form(
      action=`${prefixAdmin}/products/create`
      method="POST"
      enctype="multipart/form-data"
    )
      .form-row
        .form-col
          .form-group
            label.form-label Tên sản phẩm
              span.required *
            input.form-input(
              type="text"
              name="title"
              placeholder="Nhập tên sản phẩm"
              required
            )

          .form-group
            label.form-label Danh mục sản phẩm
            select.form-input.form-select(name="product_category_id")
              option(value="") ── Chọn danh mục ──
              if categories
                +categoryOptions(categories, 1)

          .form-group
            label.form-label Thương hiệu
            select.form-input.form-select(name="brand_id")
              option(value="") ── Chọn thương hiệu ──
              if brands
                each brand in brands
                  option(value=brand._id)= brand.name

          .form-group
            label.form-label Mô tả
            textarea.form-input.form-textarea(
              name="description"
              placeholder="Nhập mô tả sản phẩm"
              rows="5"
            )

          .form-row-inline
            .form-group.form-group-half
              label.form-label Giá (VNĐ)
                span.required *
              input.form-input(
                type="text"
                name="price"
                placeholder="Nhập giá"
                required
              )
            .form-group.form-group-half
              label.form-label Giảm giá (%)
              input.form-input(
                type="text"
                name="discountPercentage"
                placeholder="Nhập % giảm giá"
              )

          .form-row-inline
            .form-group.form-group-half
              label.form-label Số lượng
              input.form-input(
                type="text"
                name="stock"
                placeholder="Nhập số lượng"
              )
            .form-group.form-group-half
              label.form-label Vị trí
              input.form-input(
                type="text"
                name="position"
                placeholder="Tự động"
              )

          .form-group
            label.form-label Trạng thái
            select.form-input.form-select(name="status")
              option(value="active") Hoạt động
              option(value="inactive") Dừng hoạt động

          .form-group
            .form-check
              input.form-check-input(type="checkbox" name="featured" id="featured" value="true")
              label.form-check-label(for="featured") Sản phẩm nổi bật

          //- Cấu hình SEO & SEO Analyzer
          .admin-form-group-card.mt-4.mb-3.p-3.border.rounded(style="background-color: #f8f9fa;")
            h6.mb-4(style="font-size: 1.1rem; font-weight: 600; color: var(--text-primary); border-bottom: 1px solid var(--border-color); padding-bottom: 10px;")
              | Cấu hình & Phân tích SEO tự động
            
            .row
              .col-12.col-xl-7
                .form-group
                  label.form-label Từ khóa SEO chính (Focus Keyword)
                  input.form-input.seo-input#seoKeyword(
                    type="text"
                    name="seoKeyword"
                    placeholder="VD: điện thoại iphone 15..."
                  )
                  .form-text Từ khóa bạn muốn trang này lên top Google.
                
                .form-group.mt-3
                  label.form-label SEO Title
                    span.seo-count#seoTitleCount(style="font-size: 12px; margin-left: 5px; font-weight: normal;")  (0/60)
                  input.form-input.seo-input(
                    type="text"
                    name="seoTitle"
                    id="seoTitle"
                    placeholder="Tiêu đề hiển thị trên Google..."
                    data-max="60"
                    data-count-id="seoTitleCount"
                  )
                
                .form-group
                  label.form-label SEO Description
                    span.seo-count#seoDescCount(style="font-size: 12px; margin-left: 5px; font-weight: normal;")  (0/160)
                  textarea.form-input.form-textarea.seo-input(
                    name="seoDescription"
                    id="seoDescription"
                    placeholder="Mô tả hiển thị trên Google..."
                    rows="3"
                    data-max="160"
                    data-count-id="seoDescCount"
                  )
              
              .col-12.col-xl-5.mt-3.mt-xl-0
                .seo-analyzer-panel.p-3.border.rounded(style="background-color: #fff; height: 100%;")
                  h6.mb-3(style="font-size: 0.95rem; font-weight: 700;") 
                    | Đánh giá SEO: 
                    span#seoScoreBadge.badge.bg-secondary(style="font-size: 0.85rem;") Chưa có dữ liệu
                  
                  ul.list-unstyled.seo-checklist(style="font-size: 0.85rem; line-height: 1.8;")
                    li.mb-2#checkTitleLen
                      i.fas.fa-times-circle.text-danger.mr-2
                      | Độ dài SEO Title (40 - 60 ký tự)
                    li.mb-2#checkDescLen
                      i.fas.fa-times-circle.text-danger.mr-2
                      | Độ dài SEO Description (120 - 160 ký tự)
                    li.mb-2#checkFocusTitle
                      i.fas.fa-times-circle.text-danger.mr-2
                      | Từ khóa chính nằm trong SEO Title
                    li.mb-2#checkFocusDesc
                      i.fas.fa-times-circle.text-danger.mr-2
                      | Từ khóa chính nằm trong SEO Description
                    li.mb-2#checkFocusContent
                      i.fas.fa-times-circle.text-danger.mr-2
                      | Từ khóa chính nằm trong Nội dung
                    li.mb-0#checkContentLen
                      i.fas.fa-times-circle.text-danger.mr-2
                      | Nội dung sản phẩm đủ dài (> 300 từ)

          //- Biến thể sản phẩm
          .form-group
            label.form-label Biến thể sản phẩm
              span.variant-hint  (Màu sắc, kích thước, phiên bản,...)
            .variants-container#variantsContainer
            .variant-actions
              button.btn-add-variant(type="button" onclick="addVariantRow()")
                i.fas.fa-plus
                |  Thêm biến thể

        .form-col.form-col-side
          .form-group
            label.form-label Ảnh thumbnail
            .upload-area#uploadArea
              input.upload-input(
                type="file"
                name="thumbnail"
                id="uploadFile"
                accept="image/*"
              )
              .upload-placeholder#uploadPlaceholder
                i.fas.fa-cloud-upload-alt
                p Kéo thả hoặc click để chọn ảnh
                span.upload-hint Hỗ trợ: JPG, PNG, GIF, WebP (tối đa 5MB)
              img.upload-preview#uploadPreview(src="" alt="Preview")

          .form-group
            label.form-label Ảnh phụ sản phẩm (tối đa 8 ảnh)
            .multi-upload-area#multiUploadArea
              input.multi-upload-input(
                type="file"
                name="images"
                id="multiUploadFile"
                accept="image/*"
                multiple
              )
              .multi-upload-placeholder
                i.fas.fa-images
                p Click để chọn nhiều ảnh
                span.upload-hint Hỗ trợ: JPG, PNG, GIF, WebP (tối đa 5MB/ảnh)
            .multi-preview-container#multiPreviewContainer

      .form-actions
        a.btn-cancel(href=`${prefixAdmin}/products`) Huỷ
        button.btn-submit(type="submit")
          i.fas.fa-plus
          |  Tạo sản phẩm

block append scripts
  script(src="/admin/js/upload-preview.js")
  script(src="/admin/js/multi-upload-preview.js")
  script(src="/admin/libs/tinymce/tinymce.min.js")
  script(src="/admin/js/tinymce-init.js")
  script(src="/admin/js/product-variants.js")
  script(src="/admin/js/seo-checker.js")


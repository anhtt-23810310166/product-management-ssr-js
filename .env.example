# ====================================================================
# APPLICATION CONFIGURATION
# ====================================================================
PORT=3000
BASE_URL=http://localhost:3000
SESSION_SECRET=PRODUCT_MANAGEMENT_SECRET_SESSION_KEY_2026
JWT_SECRET=PRODUCT_MANAGEMENT_JWT_SUPER_SECRET_KEY_2026

# ====================================================================
# DATABASE & CACHE
# ====================================================================
# MongoDB Local hoặc MongoDB Atlas URI:
MONGO_URL=mongodb://127.0.0.1:27017/product_management
# MONGO_URL=mongodb+srv://<username>:<password>@cluster0.mongodb.net/product_management

# Redis Server (Mặc định local: redis://127.0.0.1:6379)
REDIS_URL=redis://127.0.0.1:6379

# ====================================================================
# CLOUDINARY (Lưu trữ ảnh sản phẩm, avatar)
# Đăng ký miễn phí tại: https://cloudinary.com/
# ====================================================================
CLOUDINARY_CLOUD_NAME=your_cloudinary_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# ====================================================================
# EMAIL SERVICE (Nodemailer gửi OTP & thông báo đơn hàng)
# Dùng App Password của Gmail (Cài đặt bảo mật 2 lớp -> Mật khẩu ứng dụng)
# ====================================================================
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_gmail_app_password

# ====================================================================
# VNPAY PAYMENT GATEWAY (Cổng thanh toán Sandbox)
# ====================================================================
VNPAY_TMN_CODE=TESTCODE
VNPAY_HASH_SECRET=TESTHASHSECRET123456789
VNPAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_RETURN_URL=http://localhost:3000/cart/vnpay-return

# ====================================================================
# SOCIAL LOGIN (Google & Facebook OAuth - Tùy chọn)
# ====================================================================
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
FACEBOOK_APP_ID=your_facebook_app_id
FACEBOOK_APP_SECRET=your_facebook_app_secret

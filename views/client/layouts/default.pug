html
  head
    if seoTitle
      title= seoTitle
    else if title
      title #{title} | #{settingGeneral ? settingGeneral.websiteName : "TechZone"}
    else
      title #{settingSeo && settingSeo.metaTitle ? settingSeo.metaTitle : (settingGeneral ? settingGeneral.websiteName : "TechZone")}

    meta(name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no")
    
    //- SEO Tags
    meta(name="description" content=(seoDescription || (settingSeo && settingSeo.metaDescription ? settingSeo.metaDescription : "Khám phá ngay các sản phẩm công nghệ hàng đầu tại TechZone.")))
    if seoKeywords
      meta(name="keywords" content=seoKeywords)
    else
      meta(name="keywords" content=(settingSeo && settingSeo.metaKeywords ? settingSeo.metaKeywords : "TechZone, điện thoại, laptop, phụ kiện công nghệ, mua sắm online"))

    //- Open Graph (Facebook/Zalo)
    meta(property="og:title" content=(seoTitle || title || (settingSeo && settingSeo.metaTitle ? settingSeo.metaTitle : "TechZone")))
    meta(property="og:description" content=(seoDescription || (settingSeo && settingSeo.metaDescription ? settingSeo.metaDescription : "Khám phá các sản phẩm nổi bật")))
    if seoImage
      meta(property="og:image" content=seoImage)
    else if settingSeo && settingSeo.ogImage
      meta(property="og:image" content=settingSeo.ogImage)
    else if settingGeneral && settingGeneral.logo
      meta(property="og:image" content=settingGeneral.logo)
    meta(property="og:type" content="website")

    //- Google Analytics (GA4)
    if settingSeo && settingSeo.googleAnalyticsId
      script(async src=`https://www.googletagmanager.com/gtag/js?id=${settingSeo.googleAnalyticsId}`)
      script.
        window.dataLayer = window.dataLayer || [];
        function gtag(){dataLayer.push(arguments);}
        gtag('js', new Date());
        gtag('config', '#{settingSeo.googleAnalyticsId}');
    link(rel="stylesheet", href="https://cdn.jsdelivr.net/npm/bootstrap@4.6.2/dist/css/bootstrap.min.css" integrity="sha384-xOolHFLEh07PJGoPkLv1IbcEPTNtaed2xpHsD9ESMhqIYd0nLMwNLD69Npy4HI+N" crossorigin="anonymous")
    link(rel="stylesheet", href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css")
    link(rel="preconnect" href="https://fonts.googleapis.com")
    link(rel="preconnect" href="https://fonts.gstatic.com" crossorigin)
    link(rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap")
    link(rel="stylesheet", href=`/client/css/style.css?v=${Date.now()}`)
    //- Swiper CSS
    link(rel="stylesheet", href="https://unpkg.com/swiper/swiper-bundle.min.css")
    //- CSS Thư viện Upload cho Widget Chat
    link(rel="stylesheet" type="text/css" href="https://unpkg.com/file-upload-with-preview/dist/style.css")
  body
    if (clientUser)
      span.d-none#myUserId(data-id=clientUser.id)
      
    include ../partials/header.pug

    include ../partials/flash.pug

    block main

    include ../partials/footer.pug

    include ../partials/chat-widget.pug

    //- Voice Search Overlay
    #voiceOverlay.tz-voice-overlay
      button.voice-close(onclick="stopVoiceSearch()" type="button") &times;
      .voice-circle
        i.fas.fa-microphone
      .voice-text Đang lắng nghe...
      .voice-result#voiceResult

    //- Compare Floating Bar
    #compareBar.tz-compare-bar
      .container.d-flex.align-items-center.justify-content-between
        .d-flex.align-items-center
          i.fas.fa-exchange-alt.mr-2
          span#compareCount 0
          |  sản phẩm đang so sánh
        .d-flex.align-items-center
          button.btn.btn-sm.btn-outline-light.mr-2(onclick="clearCompare()") Xóa tất cả
          button.btn.btn-sm.btn-warning.font-weight-bold(onclick="goCompare()") So sánh ngay

    script(src="https://cdn.jsdelivr.net/npm/jquery@3.5.1/dist/jquery.slim.min.js" integrity="sha384-DfXdz2htPH0lsSSs5nCTpuj/zy4C+OGpamoFVy38MVBnE+IbbVYUew+OrCXaRkfj" crossorigin="anonymous")
    script(src="https://cdn.jsdelivr.net/npm/bootstrap@4.6.2/dist/js/bootstrap.bundle.min.js" integrity="sha384-Fy6S3B9q64WdZWQUiU+q4/2Lc9npb8tCaSX9FK7E8HnRr0Jz8D6OP9dO5Vg3Q9ct" crossorigin="anonymous")
    
    //- Socket.IO Global
    script(src="/socket.io/socket.io.js")
    //- Swiper JS
    script(src="https://unpkg.com/swiper/swiper-bundle.min.js")
    script(src="/client/js/script.js")
    script(src="/client/js/recently-viewed.js")
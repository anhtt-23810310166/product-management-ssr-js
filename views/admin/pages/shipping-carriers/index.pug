extends ../../layouts/default.pug
include ../../mixins/page-header.pug
include ../../mixins/search.pug
include ../../mixins/filter-status.pug
include ../../mixins/sort.pug
include ../../mixins/pagination.pug
include ../../mixins/batch-actions.pug

block main
  div(data-crud=`${prefixAdmin}/settings/shipping-carriers`)
    +pageHeader("Quản lý hãng vận chuyển", "Thiết lập phí giao hàng cơ bản")
      .d-flex.align-items-center.gap-2
        if userPermissions && userPermissions.includes("shipping-carriers_create")
          a.btn-add-product(href=`${prefixAdmin}/settings/shipping-carriers/create`)
            i.fas.fa-plus.mr-2
            | Thêm hãng vận chuyển

  .admin-filter-bar.mb-4
    .row.align-items-center
      +filter-status(filterStatus)
      +search(keyword)
      +sort(sortOptions)
      .col-md-2
        .d-flex.gap-2
          if userPermissions && (userPermissions.includes("shipping-carriers_edit") || userPermissions.includes("shipping-carriers_delete") || userPermissions.includes("shipping-carriers_change-status"))
            +batch-actions()

  .admin-table-wrapper
    if records && records.length > 0
      table.admin-table
        thead
          tr
            if userPermissions && (userPermissions.includes("shipping-carriers_edit") || userPermissions.includes("shipping-carriers_delete") || userPermissions.includes("shipping-carriers_change-status"))
              th.col-check
                input.form-check-input(type="checkbox" id="checkAll")
            th.col-stt STT
            th.col-title Tên hãng
            th.col-price Phí mặc định
            th.col-status Trạng thái
        tbody
          each item, index in records
            tr.animate-in
              if userPermissions && (userPermissions.includes("shipping-carriers_edit") || userPermissions.includes("shipping-carriers_delete") || userPermissions.includes("shipping-carriers_change-status"))
                td.col-check
                  input.form-check-input.checkbox-item(type="checkbox" name="id" value=item.id)
              td.col-stt #{index + 1}
              td.col-title
                .product-title-cell
                  span.product-name #{item.name}
                .product-hover-actions
                  if userPermissions && userPermissions.includes("shipping-carriers_edit")
                    a.hover-action-link.hover-action-edit(href=`${prefixAdmin}/settings/shipping-carriers/edit/${item.id}`) Sửa
                  if userPermissions && userPermissions.includes("shipping-carriers_change-status")
                    if item.status === "active"
                      a.hover-action-link.hover-action-status.btn-change-status(href="javascript:void(0)" data-id=item.id data-status="active") Dừng hoạt động
                    else
                      a.hover-action-link.hover-action-status.btn-change-status(href="javascript:void(0)" data-id=item.id data-status="inactive") Hoạt động
                  if userPermissions && userPermissions.includes("shipping-carriers_delete")
                    a.hover-action-link.hover-action-danger(href="javascript:void(0)" data-id=item.id) Xoá

              td.col-price #{item.baseFee.toLocaleString()} ₫
              td.col-status
                if item.status === "active"
                  span.status-badge.status-active Hoạt động
                else
                  span.status-badge.status-inactive Dừng hoạt động
    else
      .admin-empty-state
        i.fas.fa-truck
        h4 Chưa có hãng vận chuyển nào
        p Vui lòng thêm hãng vận chuyển bằng biểu mẫu phía trên

  +pagination(pagination)

block append scripts
  script(src="/admin/js/admin-crud.js")
